{
  "name": "obsidian-foldmark",
  "version": "2.0.0",
  "description": "Obsidian plugin that converts documents to Markdown with Microsoft MarkItDown.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "markdown",
    "markitdown",
    "foldmark",
    "pdf",
    "docx"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.0",
    "obsidian": "latest",
    "typescript": "^5.4.0"
  }
}
